# Copy to .env (cp example.env .env), change every value, chmod 600 .env. Never commit .env.
KODEERP_IMAGE=kodeerp:16.51.1-kn2
DB_ROOT_PASSWORD=change-me-long-random-32-chars

# Public hostnames. Each one becomes a KodeERP site with the same name.
ERP_DOMAIN=erp.kodenova.com
FNB_DOMAIN=fnb.kodenova.com
LETSENCRYPT_EMAIL=admin@kodenova.com

# Only for compose.tunnel.yaml (Cloudflare named tunnel)
CLOUDFLARE_TUNNEL_TOKEN=

# Plain HTTP port, used only when neither compose.caddy.yaml nor compose.tunnel.yaml is added (local testing)
HTTP_PUBLISH_PORT=8080
