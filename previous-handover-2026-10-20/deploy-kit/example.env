# Copy to .env and change every value. Never commit .env.
KODEERP_IMAGE=kodeerp:16.51.1-kn1
DB_ROOT_PASSWORD=change-me-long-random
# Port for plain HTTP (when not using compose.https.yaml)
HTTP_PUBLISH_PORT=8080
# By default each request is routed to the site whose name equals the host name.
# FRAPPE_SITE_NAME_HEADER=fnb.localhost   (only for a single site restored under a non-domain name)
# HTTPS (compose.https.yaml)
SITE_DOMAIN=erp.example.com
LETSENCRYPT_EMAIL=admin@example.com
